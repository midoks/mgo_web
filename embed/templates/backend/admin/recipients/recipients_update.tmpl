{[template "backend/common/header_nonav.tmpl" .]}

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div style="display:flex;align-items:center;gap:8px;margin-bottom: 1rem;">
                    <a href="/{[.admin_path]}/admin/recipients/instances" style="display:flex;align-items:center;">
                        <i class="layui-icon layui-icon-return"></i>  
                    </a>

                    <span style="margin:0;font-size:18px;">
                        更新
                    </span>
                </div>

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        <li data-status="1"><a href="/{[.admin_path]}/admin/recipients/recipients/details?id={[.id]}">概览</a></li>
                        <li data-status="2" class="layui-this">修改</li>
                        <li data-status="3"><a href="/{[.admin_path]}/admin/recipients/recipients/test?id={[.id]}">测试</a></li>
                    </ul>
                </div>

                <div class="layui-form toolbar" style="margin-top: 10px;margin-bottom: 10px;">
                <form class="layui-form layui-form-pane" onclick="return false;">
                    <table class="layui-table">
                        <colgroup><col width="150"><col></colgroup>
                        <tbody>
                            <tr>
                                <td>系统管理员 *</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <select name="admin_id" lay-verify="required">
                                            <option value="">[选择系统管理员]</option>
                                            {[range $admin_data := .AdminList]}
                                                {[if eq $admin_data.ID $.Data.AdminID]}
                                                <option value="{[$admin_data.ID]}" selected>{[$admin_data.Username]}</option>
                                                {[else]}
                                                <option value="{[$admin_data.ID]}" >{[$admin_data.Username]}</option>
                                                {[end]}
                                            {[end]}
                                        </select>
                                    </div>
                                    <p class="layui-font-12">选择关联的系统管理员。</p>
                                </td>
                            </tr>

                            <tr>
                                <td>媒介 *</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <select name="media_id" lay-verify="required" lay-search lay-filter="media">
                                            <option value="">[选择媒介]</option>
                                            {[range $recipients_data := .RecipientsList]}
                                                {[if eq $recipients_data.ID $.Data.MediaID]}
                                                <option value="{[$recipients_data.ID]}" selected>{[$recipients_data.Name]}</option>
                                                {[else]}
                                                <option value="{[$recipients_data.ID]}" >{[$recipients_data.Name]}</option>
                                                 {[end]}
                                            {[end]}
                                        </select>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td>接收人标识</td>
                                <td>
                                    <input type="text" name="recipients_id" autocomplete="off" class="layui-input" value="{[if .Data]}{[.Data.RecipientID]}{[end]}" placeholder="">
                                </td>
                            </tr>

                            <tr>
                                <td>分组</td>
                                <td>
                                    <div id="groups">
                                        <span id="groups_btn"></span>
                                        <span id="groups_origin">
                                            <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" onclick="Admin.open('选择分组','/{[$.admin_path]}/admin/recipients/groups/select',600,450)">
                                            <i class="layui-icon layui-icon-add-circle"></i>
                                            </button>
                                        </span>
                                    <div>
                                    <p class="layui-font-12">选择当前接收人所属分组。</p>
                                </td>
                            </tr>

                            <tr>
                                <td>关联的边缘节点集群</td>
                                <td>
                                    {[range $cluster := .ClusterList]}
                                        <div class="layui-col-xs6 layui-col-sm6 layui-col-md6">
                                            <input type="checkbox" name="cluster[{[$cluster.ID]}]" lay-text="{[$cluster.Name]}">
                                        </div>
                                    {[end]}
                                </td>
                            </tr>



                            <tr>
                                <td colspan="2">
                                    <a class="table_more mlink" target_class="more_table">
                                        <cite>更多选项</cite>
                                        <i class="layui-icon layui-icon-down layui-nav-more"></i>
                                    </a>
                                </td>
                            </tr>

                            <tr class="more_table hide">
                                <td>启用当前接收人</td>
                                <td>
                                    <input type="checkbox" name="status" lay-text="" {[if .Data]}{[if .Data.Status]}checked{[end]}{[end]}> 
                                </td>
                            </tr>

                            <tr class="more_table hide">
                                <td>备注</td>
                                <td><textarea id="editor2" name="mark" class="layui-textarea" style="min-height:100px;" placeholder="">{[if .Data]}{[.Data.Mark]}{[end]}</textarea></td>
                            </tr>


                            <tr>
                                <td colspan="2">
                                    <input type="hidden" name="id" value="{[if .Data]}{[.Data.ID]}{[end]}">
                                    <button class="layui-btn" lay-filter="submit_recipients" lay-submit>保存</button>
                                </td>
                            </tr>
                            
                        </tbody>
                    </table>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;


form.on("submit(submit_recipients)", function(data){
    var index = layer.load();
    var field = data.field;

    var selected = [];
    for (var k in field) {
        if (!Object.prototype.hasOwnProperty.call(field, k)) continue;
        var m = k.match(/^cluster\[(\d+)\]$/);
        if (m) {
            if (field[k] === 'on') {
                selected.push(parseInt(m[1], 10));
            }
            delete field[k];
        }
    }
    field['cluster_ids'] = selected;

    if (field['status'] == "on"){
        field['status'] = 1;
    } else {
        field['status'] = 0;
    }

    $.ajax({
        url: "/{[$.admin_path]}/admin/recipients/add",
        type: "POST",
        data: field,
        traditional: true, // arrays -> cluster_ids=1&cluster_ids=2
        dataType: "json",
        success: function(res){
            showMsg(res.msg, function(){
                layer.close(index);
                if(res.code > -1){
                    parent.location.reload();
                }
            },{icon: res.code > -1 ? 1 : 2,shift:res.code>-1 ? 0 : 6});
        }
    });
    return false;
});

///
});
</script>

{[template "backend/common/footer.tmpl" .]}
