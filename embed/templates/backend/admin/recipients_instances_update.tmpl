{[template "backend/common/header_nonav.tmpl" .]}

<div class="layui-fluid">


    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        <li data-status="1"><a href="/{[.admin_path]}/admin/recipients/instances/details?id={[.id]}">概览</a></li>
                        <li data-status="2" class="layui-this">修改</li>
                        <li data-status="3"><a href="/{[.admin_path]}/admin/recipients/instances/test?id={[.id]}">测试</a></li>
                    </ul>
                </div>

                <div class="layui-form toolbar layui-padding-3" style="margin-top: 10px;margin-bottom: 10px;">
                <form class="layui-form layui-form-pane" onclick="return false;">
                    <table class="layui-table">
                        <colgroup><col width="150"><col></colgroup>
                        <tbody>
                            <tr>
                                <td>媒介名称 *</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="name" autocomplete="off" class="layui-input" value="" placeholder="媒介名称">
                                    </div>
                                    <br/>
                                    <p class="layui-font-12">给当前媒介填写一个容易识别的名称。</p>
                                </td>
                            </tr>

                            <tr>
                                <td>媒介类型 *</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <select name="media_type" lay-verify="required" lay-search lay-filter="media">
                                            <option value="">[选择媒介类型]</option>
                                            <option value="telegram">Telegram</option>
                                            <option value="email">邮件</option>
                                            <option value="webhook">WebHook</option>
                                        </select>
                                    </div>
                                    <br/>
                                    <p class="layui-font-12">通过HTTP请求发送通知。</p>
                                </td>
                            </tr>

                            <div id="id_telegram">
                                <tr class="id_telegram" style="display:none;">
                                    <td>机器人Token *</td>
                                    <td>
                                        <div class="layui-input-line">
                                            <input type="text" name="token" autocomplete="off" class="layui-input">
                                        </div>
                                        <p class="layui-font-12">创建机器人的时候可以获得，类似于 123456:AAAA-BBBB ，可以向 @BotFather 发送 /newbot 指令创建新的机器人。</p>
                                    </td>
                                </tr>
                            </div>

                            <div id="id_webhook">
                                <tr class="id_webhook" style="display:none;">
                                    <td>URL *</td>
                                    <td>
                                        <div class="layui-input-line">
                                            <input type="text" name="number" autocomplete="off" class="layui-input" placeholder="http://">
                                        </div>
                                        <p class="layui-font-12">可以在URL中使用 ${MessageUser} 、 ${MessageSubject} 和 ${MessageBody} 来代表接收人标识、标题和内容。</p>
                                    </td>
                                </tr>

                                <tr class="id_webhook" style="display:none;">
                                    <td>请求方法 *</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <select name="modules" lay-verify="required" lay-search>
                                                <option value="get">GET</option>
                                                <option value="post">POST</option>
                                            </select>
                                        </div>
                                    </td>
                                </tr>
                            </div>

                            <div id="id_email">
                                <tr class="id_email" style="display:none;">
                                    <td>SMTP *</td>
                                    <td>
                                        <div class="layui-input-line">
                                            <input type="text" name="number" autocomplete="off" class="layui-input" placeholder="类似于 smtp.example.com:465">
                                        </div>
                                        <p class="layui-font-12">只支持SSL（或TLS）连接，端口通常为：465或587。</p>
                                    </td>
                                </tr>

                                <tr class="id_email" style="display:none;">
                                    <td>账号 *</td>
                                    <td>
                                        <div class="layui-input-line">
                                            <input type="text" name="number" autocomplete="off" class="layui-input" placeholder="类似于 xxx@example.com">
                                        </div>
                                        <p class="layui-font-12">邮箱账号，比如 123456@qq.com。</p>
                                    </td>
                                </tr>

                                <tr class="id_email" style="display:none;">
                                    <td>密码 *</td>
                                    <td>
                                        <div class="layui-input-line">
                                            <input type="text" name="number" autocomplete="off" class="layui-input" placeholder="">
                                        </div>
                                        <p class="layui-font-12">账号对应的密码或者授权码（比如QQ邮箱就需要授权码）。</p>
                                    </td>
                                </tr>

                                <tr class="id_email" style="display:none;">
                                    <td>发送者Email</td>
                                    <td>
                                        <div class="layui-input-line">
                                            <input type="text" name="number" autocomplete="off" class="layui-input" placeholder="类似于 xxx@example.com">
                                        </div>
                                        <p class="layui-font-12">默认和账号一致</p>
                                    </td>
                                </tr>
                            </div>

                            <tr>
                                <td>发送频率 <br/>（次/分钟）</td>
                                <td>
                                    <div>
                                        <div class="layui-inline">
                                            <div class="layui-input-inline">
                                                <input style="width: 60px;" type="number" name="freq_rate" autocomplete="off" class="layui-input" value="100">
                                            </div>
                                            <label class="layui-form-label" style="width: 50px;float: right;">次</label>
                                        </div>
                                        <span>/</span>
                                        <div class="layui-inline">
                                            <div class="layui-input-inline">
                                                <input style="width: 60px;" type="number" name="freq_minute" autocomplete="off" class="layui-input" value="1">
                                            </div>
                                            <label class="layui-form-label" style="width: 70px;float: right;">分钟</label>
                                        </div>
                                    </div>
                                    <p class="layui-font-12">用来限制此媒介的发送频率，防止短时间内消息数量过载。</p>
                                </td>
                            </tr>

                            <tr>
                                <td>忽略相似消息周期</td>
                                <td>
                                    <div class="layui-inline">
                                        <div class="layui-input-inline">
                                            <input type="text" name="number" autocomplete="off" class="layui-input" value="60">
                                        </div>
                                        <label class="layui-form-label" style="float: right;">秒</label>
                                    </div>
                                    <br/>
                                    <p class="layui-font-12">可以在这个时间内忽略相似消息，防止短时间内消息数量过载。默认60秒。</p>
                                </td>
                            </tr>

                            <tr>
                                <td>备注</td>
                                <td><textarea id="editor2" name="mark" class="layui-textarea" style="min-height:100px;"></textarea></td>
                            </tr>
                        </tbody>
                    </table>


                    <div class="layui-form-item" style="text-align: center;">
                        <button class="layui-btn" lay-filter="submit_recipients" lay-submit>保存</button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;

///
});
</script>

{[template "backend/common/footer.tmpl" .]}