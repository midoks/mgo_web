{[template "backend/common/header_nonav.tmpl" .]}

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        <li data-status="1"><a href="/{[.admin_path]}/log">查询</a></li>
                        <li data-status="2"><a href="/{[.admin_path]}/log/clean">清理</a></li>
                        <li data-status="3" class="layui-this">设置</li>
                    </ul>
                </div>

                <div class="layui-form toolbar" style="margin-top: 10px;margin-bottom: 10px;">
                <form class="layui-form layui-form-pane" onclick="return false;">
                    <table class="layui-table">
                        <colgroup><col width="150"><col></colgroup>
                        <tbody>
                            <tr>
                                <td>媒介名称 *</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="name" autocomplete="off" class="layui-input" value="{[if .Data]}{[.Data.Name]}{[end]}" placeholder="媒介名称">
                                    </div>
                                    <br/>
                                    <p class="layui-font-12">给当前媒介填写一个容易识别的名称。</p>
                                </td>
                            </tr>

                
                            <tr>
                                <td>允许手动删除日志</td>
                                <td>
                                    <input type="checkbox" name="can_delete"> 
                                </td>
                            </tr>

                            <tr>
                                <td>允许手动清理</td>
                                <td>
                                    <input type="checkbox" name="can_clean"> 
                                </td>
                            </tr>

                            <tr>
                                <td>日志保留天数</td>
                                <td>
                                    <input type="number" name="days" autocomplete="off" class="layui-input" value="2" placeholder="2">
                                    <p class="layui-font-12">超过此天数的日志将会被自动清理，0表示不自动清理。</p>
                                </td>
                            </tr>

                            <tr>
                                <td>最大容量限制</td>
                                <td>
                                    <input type="checkbox" name="can_clean">
                                    <p class="layui-font-12">超出此容量限制后将会发送提醒。</p>
                                </td>
                            </tr>
                            
                            <tr>
                                <td>允许修改清除配置</td>
                                <td>
                                    <input type="checkbox" name="can_clean">
                                    <p class="layui-font-12">选中后，不能再次修改删除、清理等相关设置，防止攻击者用来擦除日志。</p>
                                </td>
                            </tr>


                            <tr>
                                <td colspan="2" >
                                    <input type="hidden" name="id" value="{[if .Data]}{[.Data.ID]}{[end]}">
                                    <button class="layui-btn" lay-filter="submit_recipients" lay-submit>保存</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;


table.render({
    elem: '#list',
    url: '/{[.admin_path]}/log/list',
    title: '数据表',
    cols: [[
        {field:'content', title:'内容'},
        {field:'uid', title:'用户ID'},
        {field:'ip', title:'IP'},
        {title:'操作', toolbar: '#cmdTpl', width:70, fixed: 'right'}
     ]],
    page: true
});


table.on('tool(list)', function(obj){
    switch(obj.event){
    };
});

table.on('toolbar', function(obj){
    switch(obj.event){
    };
});


///
});
</script>


<script type="text/html" id="cmdTpl">
<a class="layui-btn layui-btn-danger layui-btn-xs" lay-event='delete' onclick="Admin.del(this, 'delete','{{d.id}}')">删除</a>
</script>

{[template "backend/common/footer.tmpl" .]}