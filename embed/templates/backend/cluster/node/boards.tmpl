{[template "backend/common/header.tmpl" .]}

<style>
    .stats-table {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0;
        margin-top: 10px;
        border: 1px solid #e8e8e8;
        border-radius: 4px;
        overflow: hidden;
        background: #fff;
    }
    
    .stats-row {
        display: contents;
    }
    
    .stats-cell {
        border-right: 1px solid #e8e8e8;
        border-bottom: 1px solid #e8e8e8;
        padding: 15px 12px;
        position: relative;
        min-height: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    
    .stats-cell:nth-child(5n) {
        border-right: none;
    }
    
    .stats-row:last-child .stats-cell {
        border-bottom: none;
    }
    
    .stats-cell .stat-label {
        position: absolute;
        top: 10px;
        left: 15px;
        font-size: 12px;
        color: #999;
    }
    
    .stats-cell .stat-value-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-top: 15px;
    }
    
    .stats-cell .stat-value {
        font-size: 16px;
        font-weight: 500;
        color: #333;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 4px;
    }
    
    .stats-cell .stat-value .stat-number {
        color: #333;
    }
    
    .stats-cell .stat-value .stat-unit {
        font-size: 12px;
        color: #999;
        font-weight: normal;
    }
    
    .stats-cell .stat-detail {
        font-size: 14px;
        color: #333;
        margin-top: 4px;
        text-align: center;
    }

    .status-online {
        color: #00b83f;
    }

    .status-offline {
        color: #ff5722;
    }

    @media screen and (max-width: 992px) {
        .stats-table {
            display: flex;
            flex-direction: column;
            gap: 8px;
            border: none;
            border-radius: 0;
            overflow: visible;
        }
        
        .stats-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0;
            border: 1px solid #e8e8e8;
            border-radius: 4px;
            overflow: hidden;
        }
        
        .stats-cell {
            border-right: 1px solid #e8e8e8;
            border-bottom: 1px solid #e8e8e8;
        }
        
        .stats-row .stats-cell:nth-child(2n) {
            border-right: none;
        }
        
        .stats-row:last-child .stats-cell {
            border-bottom: none;
        }
    }
    
    @media screen and (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-card layadmin-header" style="display: block; line-height: 40px;height: 40px;">
                    <div class="layui-breadcrumb" lay-filter="breadcrumb">
                        {[range $menu := .Menus]}
                            {[if eq $menu.Code $.ActiveMenu]}
                                <a><cite>{[$menu.Name]}</cite></a>
                            {[end]}
                            {[range $child := $menu.Children]}
                                {[if eq $child.Code $.ActiveMenu]}
                                    <a><cite>{[$menu.Name]}</cite></a>
                                    <a><cite>{[$child.Name]}</cite></a>
                                {[end]}
                            {[end]}
                        {[end]}
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:8px;margin-top: 1rem;">
                    <a href="/{[.admin_path]}/clusters/cluster/list?cluster_id={[.cluster_id]}" style="display:flex;align-items:center;">
                        <i class="layui-icon layui-icon-return"></i>  
                    </a>
                    <span style="margin:0;font-size:18px;">
                        {[if .Data]}{[.Data.Name]}{[end]}
                    </span>
                </div>

                <div class="layui-tab layui-tab-brief" style="margin-top: 10px;">
                    <ul class="layui-tab-title" id="status">
                        {[range $menu := .submenu]}
                            <li data-status="{[$menu.Number]}" {[if eq (print "/" $.admin_path "/" $menu.Link) $.CurrentPath]}class="layui-this"{[end]}><a href="/{[$.admin_path]}/{[$menu.Link]}?cluster_id={[$.cluster_id]}&node_id={[$.node_id]}"><i class="layui-icon {[$menu.Icon]}"></i>  {[$menu.Name]}</a></li>
                        {[end]}
                    </ul>
                </div>

                <div class="cluster-boards">
                    <div class="stats-table">
                        <div class="stats-row">
                            <div class="stats-cell">
                                <div class="stat-label">在线状态</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        {[if .NodeInfo.IsActive]}
                                        <span class="stat-number status-online">在线</span>
                                        {[else]}
                                        <span class="stat-number status-offline">离线</span>
                                        {[end]}
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当前下行带宽</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">Mbps</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当前上行带宽</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">Kbps</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当前连接数</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">/分钟</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当前访问量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">/s</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stats-cell">
                                <div class="stat-label">当前攻击访问量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">0</span>
                                        <span class="stat-unit">/分钟</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">缓存硬盘用量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">{[printf "%.2f" .NodeInfo.DiskUsage]}</span>
                                        <span class="stat-unit">%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">硬盘预估写入最大速度</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">{[.NodeInfo.DiskWritingSpeedMB]}</span>
                                        <span class="stat-unit">MB/s</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">内存缓存用量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">B</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">CPU</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">{[$.CPUUsagePercent]}</span>
                                        <span class="stat-unit">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stats-cell">
                                <div class="stat-label">内存</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">{[$.MemoryUsagePercent]}</span>
                                        <span class="stat-unit">%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">总内存</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">{[$.MemoryTotalGB]}</span>
                                        <span class="stat-unit">GB</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">负载</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">{[$.Load1mFormatted]}</span>
                                        <span class="stat-unit">/分钟</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">当月流量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">GiB</span>
                                    </div>
                                </div>
                            </div>
                            <div class="stats-cell">
                                <div class="stat-label">昨日流量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">GiB</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stats-cell" style="grid-column: span 2;">
                                <div class="stat-label">今日流量</div>
                                <div class="stat-value-wrap">
                                    <div class="stat-value">
                                        <span class="stat-number">--</span>
                                        <span class="stat-unit">GiB</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- end -->
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;


///
});
</script>

{[template "backend/common/footer.tmpl" .]}