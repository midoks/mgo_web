{[template "backend/common/header_head.tmpl" .]}


<style type="text/css">
/* Layout */
.ssh-select{padding:12px;}
.ssh-search{height:40px;}
.ssh-section-title{color:#64748b;font-size:16px;margin:16px 0 8px;}
.ssh-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}

/* Card */
.ssh-card{border:1px solid #e5e7eb;border-radius:8px;padding:12px;background:#fff;cursor:pointer;transition:all .2s;}
.ssh-card:hover{border-color:#d1d5db;background:#f8fafc;}
.ssh-card .title{font-size:14px;color:#111827;margin-bottom:6px;}
.ssh-card .title .meta{color:gray;font-size:12px;margin-left:6px;}
.ssh-card .subtitle{font-size:12px;color:#374151;}

/* Selected chip */
.ssh-selected{display:inline-flex;align-items:center;gap:4px;}
.ssh-selected .name{font-size:12px;}
.ssh-selected .meta{font-size:12px;color:rgb(107 114 128);}

/* Responsive */
@media (max-width: 990px){ .ssh-grid{grid-template-columns:repeat(3,1fr);} }
</style>

<div class="layui-fluid">
    <div class="ssh-select">
        <input type="text" class="layui-input ssh-search" id="ssh_search" placeholder="搜索名称、用户名等">

        <div class="ssh-section-title">推荐认证</div>
        <div class="ssh-grid" id="ssh_grid_top"></div>

        <div class="ssh-section-title">全部认证</div>
        <div class="ssh-grid" id="ssh_grid_all"></div>

        <p></p>
    </div>

</div>


<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;

function subtitleByMethod(m){
    if(m === 'namepass'){ return '用户名+密码'; }
    if(m === 'privatekey'){ return '私钥'; }
    return '认证方式';
}
function cardTpl(item){
    var title = $('<div class="title"></div>').append(
        $('<span></span>').text(item.name),
        $('<span class="meta"></span>').text('(' + (item.username||'root') + ')')
    );
    var sub = $('<div class="subtitle"></div>').text(subtitleByMethod(item.method));
    var card = $('<div class="ssh-card"></div>').append(title, sub);
    card.on('click', function(){
        if (parent && parent.$) {

            var content = "<span style='font-size:14px;'>"+item.name+"</span>";
            content += "<span class='gray2 layui-btn-sm'>(" + subtitleByMethod(item.method) + ")</span>";
            content += "<span class='gray2 layui-btn-sm'>(" + (item.username || 'root') + ")</span>";
            content += '<a class="remove" style="padding-left:3px;cursor:pointer;">X</a>';

            parent.$('.ssh_btn').html('<div><span class="layui-btn layui-btn-primary layui-btn-sm" \
                    style="margin-right:8px;">'+ content +'</span></div>');
            parent.$('.ssh_origin').hide();
            if (parent.window.loadSshBtn) parent.window.loadSshBtn();
            var idx = parent.layer.getFrameIndex(window.name);
            parent.layer.close(idx);
        }
    });
    return card;
}
function render(list){
    var top = $('#ssh_grid_top').empty();
    var all = $('#ssh_grid_all').empty();
    var rec = list.slice(0, 3);
    rec.forEach(function(it){ top.append(cardTpl(it)); });
    list.forEach(function(it){ all.append(cardTpl(it)); });
}

function renderList(list){
    var all = $('#ssh_grid_all').empty();
    list.forEach(function(it){ all.append(cardTpl(it)); });
}

function renderSuggest(list){
    var top = $('#ssh_grid_top').empty();
    list.forEach(function(it){ top.append(cardTpl(it)); });
}

function filter(list, key){
    key = (key||'').toLowerCase();
    if(!key) return list;
    return list.filter(function(it){
        return (it.name||'').toLowerCase().indexOf(key)>-1
            || (it.username||'').toLowerCase().indexOf(key)>-1;
    });
}

var allList = [];
$.get('/{[.admin_path]}/clusters/ssh/select_list?cluster_id={[.cluster_id]}', function(data){
    console.log(data.data);
    // var data = data.data.list;
    if (data.code >0){
        renderList(data.data.list); 
    }
}, 'json');

$('#ssh_search').on('input', function(){
    render(filter(allList, $(this).val()));
});

});
</script>

{[template "backend/common/footer.tmpl" .]}
