{[template "backend/common/header.tmpl" .]}

<div class="layui-fluid">
    <div class="layui-col-md12" style="padding: 5px;">
        <div class="layui-card">
            <div class="layui-card-body">

                <div class="layui-tab layui-tab-brief">
                    <ul class="layui-tab-title" id="status">
                        {[range $menu := .submenu]}
                            <li data-status="{[$menu.Number]}" {[if eq (print "/" $.admin_path "/" $menu.Link) $.CurrentPath]}class="layui-this"{[end]}><a href="/{[$.admin_path]}/{[$menu.Link]}?cluster_id={[$.cluster_id]}">{[$menu.Name]}</a></li>
                        {[end]}
                    </ul>
                </div>

                <div class="layui-form toolbar">
                <form class="layui-form layui-form-pane" onclick="return false;">
                    <table class="layui-table">
                        <colgroup><col width="150"><col></colgroup>
                        <tbody>
                            <tr>
                                <td>节点名称</td>
                                <td><input type="text" name="name" autocomplete="off" placeholder="" lay-verify="required" class="layui-input"></td>
                            </tr>

                            <tr>
                                <td>IP地址</td>
                                <td>

                                    <div id="ip">
                                        <span id="ip_btn"></span>
                                        <span id="ip_origin">
                                            <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" onclick="Admin.open('添加IP地址','/{[$.admin_path]}/clusters/select/ip',700,550)">
                                            <i class="layui-icon layui-icon-add-circle"></i>
                                            </button>
                                        </span>
                                    <div>

                                    
                                </td>
                            </tr>

                            <tr>
                                <td>所属分组</td><td>
                                <div id="group">
                                    <span id="group_btn"></span>
                                    <span id="group_origin">
                                        <a class="mlink" onclick="Admin.open('选择分组','/{[$.admin_path]}/clusters/select/groups',500,330)">[选择分组]</a>
                                        <a class="mlink" onclick="Admin.open('添加分组','/{[$.admin_path]}/clusters/cluster/groups_add',500,330)">[添加分组]</a>
                                    </span>
                                <div>
                                </td>
                            </tr>

                            <tr>
                                <td>所属区域</td><td>
                                <div id="region">
                                    <span id="region_btn"></span>
                                    <span id="region_origin">
                                        <a class="mlink" onclick="Admin.open('选择区域','/{[$.admin_path]}/clusters/select/region',500,330)">[选择区域]</a>
                                        <a class="mlink" onclick="Admin.open('添加区域','/{[$.admin_path]}/clusters/regions/add',500,330)">[添加区域]</a>
                                    </span>
                                <div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <button type="submit" class="layui-btn" lay-submit lay-filter="submit">保存</button>
                </form>
                </div>
            <!--  end  -->
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

layui.config({base: '/static/layuiadmin/'}).use(['table','jquery'], function(){
///
var admin = layui.admin
,$ = layui.$
,form = layui.form
,table = layui.table;
var util = layui.util;

window.loadRegionBtn = function(){
    $('#region_btn .remove').bind('click',function(){
        $(this).parent().parent().remove();
        $('#region_origin').show();
    });
}

window.loadGroupBtn = function(){
    $('#group_btn .remove').bind('click',function(){
        $(this).parent().parent().remove();
        $('#group_origin').show();
    });
}

///
});
</script>

{[template "backend/common/footer.tmpl" .]}
